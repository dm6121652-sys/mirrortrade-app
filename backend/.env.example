NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081
TRADING_MODE=approval_demo
JWT_SECRET=replace_with_a_long_random_secret

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mirrortrade
DATABASE_USER=mirrortrade
DATABASE_PASSWORD=change_this_to_a_long_unique_password
DATABASE_SSL=false

# Keep every secret out of Git. Use provider-specific test credentials locally.
DERIV_APP_ID=your_deriv_app_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_WEBHOOK_URL=https://your-public-api.example.com/api/v1/webhook/telegram

# TDLib reader account — server-side only. Obtain API values from my.telegram.org.
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TDLIB_DATABASE_DIRECTORY=./data/tdlib
TDLIB_FILES_DIRECTORY=./data/tdlib-files
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_hash
ENCRYPTION_KEY=base64_encoded_32_byte_key
